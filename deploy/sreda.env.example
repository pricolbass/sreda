SREDA_DATA_DIR=/var/lib/sreda
SREDA_SOCKET=/run/sreda/http.sock
SREDA_ORIGIN=https://cabinet.example.com

# All three are required to allow machine enrollment. The root-managed helper
# socket must be accessible only to the sreda service account.
# SREDA_NETWORK_SOCKET=/run/sreda-network/control.sock
# SREDA_WG_PUBLIC_KEY=BASE64_GATEWAY_PUBLIC_KEY
# SREDA_WG_ENDPOINT=PUBLIC_GATEWAY_IP:51820

# Common publication zone; immutable after first configuration.
# SREDA_ZONE=example.com
